' Relacionamentos
Campus ||--o{ Setor : "possui"
Setor ||--o{ Responsavel : "possui"
Setor ||--o{ Sala : "possui"
Setor ||--o{ Usuario : "pertence"
Responsavel ||--o{ Patrimonio : "responsável por"
Sala ||--o{ Patrimonio : "localizado em"
Inventario ||--o{ Coleta : "possui"
Patrimonio ||--o{ Coleta : "coletado em"
Patrimonio ||--o{ QRCode : "possui"
Coletor ||--o{ Coleta : "realiza"
Usuario }o--|| PerfilUsuario : "possui"

' Novos relacionamentos
Inventario ||--o{ ParticipanteInventario : "possui"
Usuario ||--o{ ParticipanteInventario : "participa"
Inventario ||--o{ SalaInventario : "possui"
Sala ||--o{ SalaInventario : "inventariada em"
ParticipanteInventario ||--o{ SalaInventario : "responsável por"
Inventario ||--o{ InventarioSetor : "possui"
Setor ||--o{ InventarioSetor : "incluído em"
Usuario ||--o{ MobileConnection : "conecta via"

