@startuml Diagrama de Casos de Uso
!theme plain
title Sistema de Inventário - Casos de Uso

left to right direction

actor "Administrador" as Admin
actor "Gestor" as Gestor
actor "Operador" as Operador
actor "Usuário Consulta" as Consulta
actor "Coletor" as Coletor
actor "Sistema IA" as IA

package "Sistema de Inventário" {
    
    package "Gestão de Usuários" {
        usecase "Gerenciar Usuários" as UC01
        usecase "Autenticar Usuário" as UC02
        usecase "Alterar Senha" as UC03
        usecase "Bloquear/Desbloquear Usuário" as UC04
        usecase "Definir Perfis de Acesso" as UC05
    }
    
    package "Gestão de Patrimônio" {
        usecase "Cadastrar Patrimônio" as UC06
        usecase "Consultar Patrimônio" as UC07
        usecase "Atualizar Patrimônio" as UC08
        usecase "Excluir Patrimônio" as UC09
        usecase "Gerar QR Code" as UC10
        usecase "Ler QR Code" as UC11
        usecase "Categorizar Patrimônio" as UC12
    }
    
    package "Gestão Organizacional" {
        usecase "Gerenciar Campus" as UC13
        usecase "Gerenciar Setores" as UC14
        usecase "Gerenciar Salas" as UC15
        usecase "Gerenciar Responsáveis" as UC16
    }
    
    package "Processo de Inventário" {
        usecase "Criar Inventário" as UC17
        usecase "Planejar Inventário" as UC18
        usecase "Executar Coleta" as UC19
        usecase "Registrar Divergências" as UC20
        usecase "Finalizar Inventário" as UC21
        usecase "Monitorar Progresso" as UC22
    }
    
    package "Coleta de Dados" {
        usecase "Coletar Patrimônio" as UC23
        usecase "Registrar Localização" as UC24
        usecase "Fotografar Patrimônio" as UC25
        usecase "Registrar Estado Conservação" as UC26
        usecase "Identificar Itens sem Etiqueta" as UC27
        usecase "Sincronizar Dados Offline" as UC28
    }
    
    package "Relatórios e Análises" {
        usecase "Gerar Relatórios" as UC29
        usecase "Exportar Dados" as UC30
        usecase "Visualizar Dashboards" as UC31
        usecase "Analisar Estatísticas" as UC32
        usecase "Gerar Relatório PDF" as UC33
        usecase "Exportar Excel" as UC34
    }
    
    package "Inteligência Artificial" {
        usecase "Categorizar Automaticamente" as UC35
        usecase "Predizer Manutenção" as UC36
        usecase "Analisar Padrões de Uso" as UC37
        usecase "Otimizar Distribuição" as UC38
        usecase "Treinar Modelos IA" as UC39
        usecase "Monitorar Performance IA" as UC40
    }
    
    package "Chatbot e Assistência" {
        usecase "Interagir com Chatbot" as UC41
        usecase "Consultar Informações" as UC42
        usecase "Obter Análises IA" as UC43
        usecase "Fornecer Feedback" as UC44
        usecase "Buscar Patrimônios" as UC45
    }
    
    package "Documentos Legais" {
        usecase "Processar Documentos" as UC46
        usecase "Classificar Documentos" as UC47
        usecase "Extrair Informações" as UC48
        usecase "Integrar Conhecimento" as UC49
        usecase "Buscar Documentos" as UC50
    }
    
    package "Configuração e Manutenção" {
        usecase "Configurar Sistema" as UC51
        usecase "Gerenciar Backup" as UC52
        usecase "Monitorar Sistema" as UC53
        usecase "Configurar IA" as UC54
        usecase "Atualizar Base Conhecimento" as UC55
    }
}

