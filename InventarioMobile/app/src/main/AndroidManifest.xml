<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissões necessárias -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Permissões de câmera com configurações específicas para Android 14 -->
    <uses-permission android:name="android.permission.CAMERA" />
    
    <!-- Permissões de armazenamento -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    
    <!-- Permissões de localização -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Permissão de vibração para feedback tátil -->
    <uses-permission android:name="android.permission.VIBRATE" />
    
    <!-- Permissão de áudio para busca por voz -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    
    <!-- Permissões de biometria -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    
    <!-- Permissões específicas para Android 14+ -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Permissões revistas para Req 12 (spec correcoes-seguranca) -->
    <!-- Permissões para compatibilidade com Android 14 -->
    <!-- SYSTEM_ALERT_WINDOW removida: não há uso de overlay/TYPE_APPLICATION_OVERLAY no app. -->
    <!-- USE_FULL_SCREEN_INTENT removida: nenhum chamador de NotificationCompat.Builder.setFullScreenIntent(). -->

    
    <!-- Features de câmera com configurações específicas para Android 14 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.camera2"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <application
        android:name=".InventarioMobileApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InventarioMobile"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="false"
        android:preserveLegacyExternalStorage="false"
        android:enableOnBackInvokedCallback="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        tools:targetApi="34">
        
        <!-- Splash Screen Activity -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.InventarioMobile.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- Main Activity -->
        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Login Activity -->
        <activity
            android:name=".presentation.login.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Scanner Activity -->
        <activity
            android:name=".presentation.scanner.ScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar" />
        
        <!-- Sala Selection Activity -->
        <activity
            android:name=".presentation.sala.SalaSelectionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Sala Selection Paging Activity (Otimizada) -->
        <activity
            android:name=".presentation.sala.SalaSelectionPagingActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Manual Collection Activity -->
        <activity
            android:name=".presentation.coleta.ManualCollectionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Collection View Activity -->
        <activity
            android:name=".presentation.coleta.CollectionViewActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Escolha Método Coleta Activity (IA ou Manual) -->
        <!-- REMOVIDA DO FLUXO ATIVO — Requisito 1.2 (simplificacao-navegacao) -->
        <!-- O fluxo DESCRICAO agora navega diretamente para DescricaoSelectionActivity. -->
        <!-- O arquivo .kt é mantido como código morto para preservar histórico.       -->
        <!--
        <activity
            android:name=".presentation.coleta.EscolhaMetodoColetaActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        -->
        
        <!-- Descricao Selection Activity -->
        <activity
            android:name=".presentation.descricao.DescricaoSelectionActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Network Diagnostic Activity -->
        <activity
            android:name=".presentation.activity.NetworkDiagnosticActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Settings Activity -->
        <activity
            android:name=".presentation.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Statistics Activity -->
        <activity
            android:name=".presentation.statistics.StatisticsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Sync Activity -->
        <activity
            android:name=".presentation.sync.SyncActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Pending Collections Activity -->
        <activity
            android:name=".presentation.sync.PendingCollectionsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Inventario Activity -->
        <activity
            android:name=".presentation.inventario.InventarioActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustPan" />
        
        <!-- Inventario Tabs Activity (Por Responsável / Por Sala) -->
        <activity
            android:name=".presentation.inventario.InventarioTabsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Filtros Activity -->
        <activity
            android:name=".presentation.filtros.FiltrosActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Coletas Activity Clean (Clean Architecture) -->
        <activity
            android:name=".presentation.coletas.ColetasActivityClean"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Coletas Unificada Activity (fusão de ColetasActivityClean + CollectionViewActivity) -->
        <!-- Requisitos: 2.1–2.12, 3.1, 3.2, 3.4 -->
        <activity
            android:name=".presentation.coletas.ColetasUnificadaActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Item Sem Etiqueta Activity -->
        <activity
            android:name=".presentation.coleta.ItemSemEtiquetaActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Quick Search Activity -->
        <activity
            android:name=".presentation.search.QuickSearchActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Patrimonio Detail Activity -->
        <activity
            android:name=".presentation.detail.PatrimonioDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Export PDF Activity -->
        <activity
            android:name=".presentation.export.ExportPdfActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Historico Scans Activity (v2.11) -->
        <activity
            android:name=".presentation.historico.HistoricoScansActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventarioMobile.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        
        <!-- Work Manager para sincronização -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
        
        <!-- File Provider para compartilhamento de arquivos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        
        <!-- Desabilitar inicialização automática do WorkManager -->
        <!-- Necessário para usar HiltWorkerFactory customizado -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
        
    </application>

</manifest>