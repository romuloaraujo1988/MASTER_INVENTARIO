<?xml version="1.0" encoding="utf-8"?>
<!--
    Item da lista de sugestões de descrição (autocomplete) na coleta de
    item sem etiqueta. Layout intencionalmente simples e compacto para
    exibir muitos itens simultaneamente (até 50 online / 10 offline).
    Usa ripple nativo (?attr/selectableItemBackground) para feedback de toque
    e truncamento em 2 linhas para descrições longas.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tvDescricao"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:ellipsize="end"
    android:maxLines="2"
    android:minHeight="48dp"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:textAppearance="?attr/textAppearanceSubtitle1"
    android:textColor="?attr/colorOnSurface"
    tools:text="CADEIRA GIRATÓRIA PRETA COM BRAÇO REGULÁVEL" />
