<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:clickable="true"
    android:focusable="true">

    <!-- Card com a foto -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFoto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/textViewDescricao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonFechar"
        app:layout_constraintVertical_bias="0.5">

        <ImageView
            android:id="@+id/imageViewFoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@string/foto_referencia_descricao"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_image_placeholder" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Botão fechar -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/buttonFechar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/foto_referencia_fechar"
        android:src="@drawable/ic_close"
        app:backgroundTint="@color/white"
        app:fabSize="mini"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_primary" />

    <!-- Descrição do patrimônio -->
    <TextView
        android:id="@+id/textViewDescricao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_rounded_white"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:padding="16dp"
        android:textAppearance="?attr/textAppearanceBody1"
        android:textColor="@color/text_primary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="COMPUTADOR DESKTOP DELL OPTIPLEX 7090"
        tools:visibility="visible" />

    <!-- Dica de zoom -->
    <TextView
        android:id="@+id/textViewDica"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/foto_referencia_ampliar"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/white_70"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardFoto" />

</androidx.constraintlayout.widget.ConstraintLayout>
