<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout customizado da CaptureActivity do ZXing.

    O ZXing inflaria um layout padrão minimalista (só a câmera + texto de
    prompt). Aqui adicionamos sobreposições com feedback para o coletor
    sem precisar sair da câmera:

      - Contador de coletas da sessão (topo, centro)
      - Último patrimônio lido com sucesso (topo, direita)
      - Chip com a sala selecionada (topo, esquerda — informativo)

    IDs obrigatórios do ZXing (não renomear):
      * @id/zxing_barcode_scanner — o preview da câmera
      * @id/zxing_status_view     — o texto de prompt
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/customCaptureRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Preview da câmera ZXing — ocupa toda a tela -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/zxing_barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:zxing_framing_rect_height="240dp"
        app:zxing_framing_rect_width="240dp"
        app:zxing_preview_scaling_strategy="fitCenter"
        app:zxing_use_texture_view="true" />

    <!-- Texto de prompt nativo do ZXing (ocultado — usamos o nosso abaixo) -->
    <TextView
        android:id="@id/zxing_status_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:text=""
        android:textColor="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════
         CAMADA DE FEEDBACK — topo da tela
         ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutTopFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Linha 1: contador + botão fechar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Botão fechar/voltar -->
            <ImageButton
                android:id="@+id/btnFechar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/bg_status_pill"
                android:contentDescription="Fechar scanner"
                app:tint="@android:color/white" />

            <!-- Chip contador de coletas -->
            <LinearLayout
                android:id="@+id/chipContador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_status_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="#80FF80"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvContadorColetas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" coletados"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Flash toggle -->
            <ImageButton
                android:id="@+id/btnFlash"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_flash_off"
                android:background="@drawable/bg_status_pill"
                android:contentDescription="Ligar lanterna"
                app:tint="@android:color/white" />

            <!-- Troca rápida de câmera (frontal ↔ traseira)
                 Sutilmente posicionado ao lado do flash. Visível apenas quando
                 o dispositivo possui mais de uma câmera (ver inicializarTrocaCamera). -->
            <ImageButton
                android:id="@+id/btnTrocarCamera"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_camera_switch"
                android:background="@drawable/bg_status_pill"
                android:contentDescription="Trocar câmera"
                android:visibility="gone"
                app:tint="@android:color/white"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- Linha 2: sala selecionada -->
        <TextView
            android:id="@+id/tvSalaAtual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:drawableStart="@drawable/ic_location"
            android:drawablePadding="6dp"
            android:drawableTint="@android:color/white"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="280dp"
            android:visibility="gone"
            tools:text="Sala: Laboratório 101"
            tools:visibility="visible" />

        <!-- Linha 3: último coletado -->
        <TextView
            android:id="@+id/tvUltimoColetado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_badge_success"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:drawableStart="@drawable/ic_check"
            android:drawablePadding="6dp"
            android:drawableTint="@android:color/white"
            android:maxLines="1"
            android:ellipsize="end"
            android:maxWidth="280dp"
            android:visibility="gone"
            tools:text="Último: 12345"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════
         CAMADA DE ZOOM — canto direito da tela
         Botões + e - para aproximar/afastar, com indicador do nível atual.
         Posicionado no centro vertical para facilitar alcance com o polegar
         quando segurando o celular com uma mão.
         ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutZoom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="4dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_add"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Aumentar zoom"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/tvZoomLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="4dp"
            android:text="1x"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:minWidth="32dp"
            android:gravity="center"
            tools:text="2.5x" />

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Diminuir zoom"
            app:tint="@android:color/white" />

    </LinearLayout>

    <!-- SeekBar de zoom — barra fina no rodapé acima do status.
         Permite ajuste fino (arrasto) como complemento aos botões +/-. -->
    <SeekBar
        android:id="@+id/seekZoom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="80dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@android:color/white"
        android:thumbTint="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/tvStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════
         CAMADA DE FEEDBACK — rodapé da tela
         Texto de status / prompt custom (substitui o do ZXing)
         ═══════════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:text="Aponte para o QR Code ou código de barras"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        app:layout_constraintBottom_toTopOf="@id/layoutAtalhosColeta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════
         MENU_ATALHOS — faixa de atalhos de coleta no rodapé
         (feature atalhos-coleta-rapida — exposição também na câmera ao vivo)

         Posicionado no rodapé, FORA da mira central (240dp) para não obstruir
         a leitura (Req 6.2/6.3). Reaproveita a linguagem visual de "pill"
         (@drawable/bg_status_pill + texto/ícone brancos) já adotada pelos
         demais controles desta câmera, em vez de Material Chips — mantendo a
         consistência visual desta tela (Req 6.1).

         Cada controle tem altura mínima de 48dp (Req 7.3), contentDescription
         (Req 7.1) e é clicável/focável.
         ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutAtalhosColeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Atalho_Sem_Etiqueta -->
        <LinearLayout
            android:id="@+id/atalhoSemEtiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginHorizontal="5dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Abrir coleta sem etiqueta">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_content_copy"
                android:layout_marginEnd="6dp"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sem etiqueta"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Atalho_Manual -->
        <LinearLayout
            android:id="@+id/atalhoManual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginHorizontal="5dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Abrir coleta manual por número">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_edit"
                android:layout_marginEnd="6dp"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Atalho_Descricao -->
        <LinearLayout
            android:id="@+id/atalhoDescricao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:layout_marginHorizontal="5dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Abrir coleta por descrição">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:layout_marginEnd="6dp"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descrição"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
