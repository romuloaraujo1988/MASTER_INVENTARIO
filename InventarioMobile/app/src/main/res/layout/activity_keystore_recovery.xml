<?xml version="1.0" encoding="utf-8"?>
<!--
    CR-02 (correcoes-seguranca — maio/2026): layout da tela de recuperação
    exibida quando o Android Keystore fica inacessível e o banco SQLCipher
    não pode ser aberto. Não usa Material Components avançados para reduzir
    superfície de bibliotecas que possam falhar pelo mesmo motivo que
    trouxe o usuário aqui.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md3_background"
    android:fillViewport="true"
    tools:context=".security.KeystoreRecoveryActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@android:drawable/ic_dialog_alert"
            android:contentDescription="@string/keystore_recovery_title"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keystore_recovery_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/md3_on_background"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvRecoveryMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/md3_on_surface_variant"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keystore_recovery_warning"
            android:textSize="14sp"
            android:textColor="@color/md3_on_error_container"
            android:background="@color/md3_error_container"
            android:padding="16dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnResetData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/keystore_recovery_reset_button"
            android:textColor="@color/md3_on_error"
            android:background="@color/md3_error"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />

    </LinearLayout>

</ScrollView>
