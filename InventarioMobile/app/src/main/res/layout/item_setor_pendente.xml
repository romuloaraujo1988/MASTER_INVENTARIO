<?xml version="1.0" encoding="utf-8"?>
<!--
    Item de "Setor Pendente" — exibido em rvSetores no RankingsFragment.
    Mostra: nome do setor, total/pendentes/coletados, barra de progresso
    de conclusão e percentual concluído.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:android_app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvNome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Departamento de TI" />

        <TextView
            android:id="@+id/tvPendentes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/warning"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="42" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="pendentes"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvDetalhe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="58 / 100 coletados · 58%" />

    <ProgressBar
        android:id="@+id/progressConclusao"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:max="100"
        tools:progress="58" />

</LinearLayout>
