<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".presentation.coleta.ManualCollectionActivity">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Informação da Sala -->
    <TextView
        android:id="@+id/tvSalaInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/info_background"
        android:padding="12dp"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        tools:text="Sala: Laboratório de Informática 1" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Coleta Manual"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Digite o número do patrimônio para coletar"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="Número do Patrimônio"
                app:boxStrokeColor="@color/colorPrimary"
                app:hintTextColor="@color/colorPrimary"
                app:endIconMode="custom"
                app:endIconDrawable="@drawable/ic_mic"
                app:endIconTint="@color/primary"
                app:endIconContentDescription="Busca por voz">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPatrimonioNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textSize="18sp"
                    android:imeOptions="actionDone" />

            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="end">

                <!--
                    ✅ v2.30: Botões refeitos para garantir contraste.
                    Antes usavam `style=...OutlinedButton` (texto cor primária)
                    com `android:backgroundTint` aplicado em cima, resultando
                    em texto escuro sobre fundo escuro/colorido = ilegível.
                    Agora são Material Buttons preenchidos com cor de texto
                    explícita branca/escura conforme o fundo.
                -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Limpar"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:backgroundTint="@color/background_light"
                    app:cornerRadius="8dp"
                    app:strokeColor="@color/text_secondary"
                    app:strokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearch"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.2"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="Buscar"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    app:backgroundTint="@color/colorSecondary"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_search"
                    app:iconTint="@android:color/white"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    app:iconPadding="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCollect"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.2"
                    android:layout_marginStart="4dp"
                    android:text="Coletar"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:enabled="false"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_check"
                    app:iconTint="@android:color/white"
                    app:iconGravity="textStart"
                    app:iconSize="16dp"
                    app:iconPadding="4dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <!-- Informações do Patrimônio — card estruturado (mesmo padrão visual do scanner) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPatrimonioInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Linha 1: número + badge de status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvPatrimonioNumero"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Nº 123456" />

                <TextView
                    android:id="@+id/tvPatrimonioStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_badge_success"
                    tools:text="✓ Disponível" />

            </LinearLayout>

            <!-- Linha 2: descrição -->
            <TextView
                android:id="@+id/tvPatrimonioDescricaoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Computador Desktop Dell Optiplex 7080" />

            <!-- Linha 3: sala + responsável com ícones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_location"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvPatrimonioSalaCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Lab. Informática" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_person"
                    app:tint="?attr/colorOnSurfaceVariant"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tvPatrimonioResponsavelCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="João Silva" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="?attr/colorOutlineVariant" />

            <!-- Informações de coleta anterior (visível quando já coletado) -->
            <LinearLayout
                android:id="@+id/layoutInfoColetaAnterior"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:padding="10dp"
                android:background="@drawable/bg_info_coleta"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvColetadoPorCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:drawableStart="@drawable/ic_person"
                    android:drawablePadding="6dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Coletado por: João Silva" />

                <TextView
                    android:id="@+id/tvDataColetaCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="6dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Em: 27/05/2026 10:30" />

            </LinearLayout>

            <!-- TextView legado — mantido para compatibilidade com código que ainda o usa -->
            <TextView
                android:id="@+id/tvPatrimonioInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textSize="14sp"
                android:textColor="@color/text_primary" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Botão Coletar Similar (aparece após coleta bem-sucedida) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnColetarSimilar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="Coletar item similar (sem placa)"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:icon="@drawable/ic_content_copy"
        app:iconSize="20dp"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:backgroundTint="@color/teal_700"
        app:cornerRadius="12dp" />

    <!-- Card de Foto Opcional (v2.11) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFotoOpcional"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/textFotoLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📷 Foto (opcional)"
                android:textSize="14sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Adicione foto se houver divergência ou estado ruim"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddPhoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Adicionar Foto"
                app:icon="@drawable/ic_camera"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <FrameLayout
                android:id="@+id/layoutPhotoPreview"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgPhotoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/black" />

                <ImageButton
                    android:id="@+id/btnRemovePhoto"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_circle_error"
                    android:src="@drawable/ic_close"
                    android:tint="@android:color/white"
                    android:contentDescription="Remover foto" />

            </FrameLayout>

            <!-- Seleção de motivo da foto -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutMotivoFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:hint="Motivo da foto">

                <AutoCompleteTextView
                    android:id="@+id/spinnerMotivoFoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvCollectionCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Total coletado na sala: 0"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layoutDicas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Dicas:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="🎤 Clique no microfone para busca por voz"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📷 Use o scanner QR Code para coleta rápida"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <!-- Botão Voltar ao Dashboard (v2.7) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackToDashboard"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:text="Voltar ao Dashboard"
        android:textSize="14sp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_home"
        app:iconGravity="textStart"
        app:strokeColor="@color/primary"
        app:strokeWidth="1dp" />

</LinearLayout>

</androidx.core.widget.NestedScrollView>
