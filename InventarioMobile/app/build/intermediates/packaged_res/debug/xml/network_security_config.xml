<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 
        Configuração específica para Android 14+
        Permite HTTP apenas para IPs locais específicos
        Em PRODUÇÃO, use HTTPS e configure domínios específicos.
    -->
    
    <!-- Configuração para desenvolvimento - Permitir HTTP em redes locais -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- IPs conhecidos do servidor -->
        <domain includeSubdomains="false">10.14.250.228</domain>
        <domain includeSubdomains="false">10.14.250.238</domain>
        <domain includeSubdomains="false">10.14.250.236</domain>
        <domain includeSubdomains="false">192.168.11.136</domain>
        
        <!-- Ranges comuns de IP local - Casa -->
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.1.100</domain>
        <domain includeSubdomains="false">192.168.1.101</domain>
        <domain includeSubdomains="false">192.168.1.102</domain>
        <domain includeSubdomains="false">192.168.1.103</domain>
        <domain includeSubdomains="false">192.168.1.104</domain>
        <domain includeSubdomains="false">192.168.1.105</domain>
        
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">192.168.0.100</domain>
        <domain includeSubdomains="false">192.168.0.101</domain>
        <domain includeSubdomains="false">192.168.0.102</domain>
        <domain includeSubdomains="false">192.168.0.103</domain>
        <domain includeSubdomains="false">192.168.0.104</domain>
        <domain includeSubdomains="false">192.168.0.105</domain>
        
        <!-- Range 192.168.10.x -->
        <domain includeSubdomains="false">192.168.10.1</domain>
        <domain includeSubdomains="false">192.168.10.100</domain>
        <domain includeSubdomains="false">192.168.10.101</domain>
        <domain includeSubdomains="false">192.168.10.102</domain>
        <domain includeSubdomains="false">192.168.10.103</domain>
        <domain includeSubdomains="false">192.168.10.104</domain>
        <domain includeSubdomains="false">192.168.10.105</domain>
        <domain includeSubdomains="false">192.168.10.107</domain>
        
        <!-- Range 10.0.x.x comum -->
        <domain includeSubdomains="false">10.0.0.1</domain>
        <domain includeSubdomains="false">10.0.0.100</domain>
        <domain includeSubdomains="false">10.0.0.101</domain>
        <domain includeSubdomains="false">10.0.0.102</domain>
        
        <!-- Localhost e emulador -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
    
    <!-- Configuração base - Permitir HTTP para desenvolvimento -->
    <!-- ATENÇÃO: Em produção, mude para cleartextTrafficPermitted="false" -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
