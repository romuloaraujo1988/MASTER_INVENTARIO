<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.consulta.DetalhePatrimonioActivity">

    <!-- ScrollView com Conteúdo -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card: Dados Básicos -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📦 Dados Básicos"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/holo_blue_dark"
                        android:layout_marginBottom="16dp" />

                    <!-- Código -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Código:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/tvCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="12345"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp"
                        tools:text="12345" />

                    <!-- Descrição -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Descrição:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/tvDescricao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cadeira Giratória Executiva"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp"
                        tools:text="Cadeira Giratória Executiva" />

                    <!-- Marca -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Marca:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/tvMarca"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Marca X"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp"
                        tools:text="Marca X" />

                    <!-- Modelo -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Modelo:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/tvModelo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Executive Pro"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp"
                        tools:text="Executive Pro" />

                    <!-- Número de Série -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Número de Série:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/tvNumeroSerie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="SN123456"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp"
                        tools:text="SN123456" />

                    <!-- Estado -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Estado:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/tvEstado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="BOM"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp"
                        tools:text="BOM" />

                    <!-- Valor -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Valor:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/tvValor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="R$ 450,00"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/holo_green_dark"
                        android:layout_marginBottom="12dp"
                        tools:text="R$ 450,00" />

                    <!-- Observações -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Observações:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/tvObservacoes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sem observações"
                        android:textSize="14sp"
                        android:textColor="@android:color/darker_gray"
                        tools:text="Patrimônio em bom estado" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card: Localização -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍 Localização"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/holo_blue_dark"
                        android:layout_marginBottom="16dp" />

                    <!-- Sala -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sala:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/tvLocalizacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sala 101 - Bloco A - 1º Andar"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp"
                        tools:text="Sala 101 - Bloco A - 1º Andar" />

                    <!-- Bloco -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bloco:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/tvSalaBloco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Bloco A"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp"
                        tools:text="Bloco A" />

                    <!-- Andar -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Andar:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/tvSalaAndar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1º Andar"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        tools:text="1º Andar" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card: Responsável -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👤 Responsável"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/holo_blue_dark"
                        android:layout_marginBottom="16dp" />

                    <!-- Nome -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Nome:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/tvResponsavel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="João Silva - Mat: 12345 (TI)"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp"
                        tools:text="João Silva - Mat: 12345 (TI)" />

                    <!-- Matrícula -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Matrícula:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/tvResponsavelMatricula"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="12345"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="12dp"
                        tools:text="12345" />

                    <!-- Setor -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Setor:"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/tvResponsavelSetor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tecnologia da Informação"
                        android:textSize="16sp"
                        android:textColor="@android:color/black"
                        tools:text="Tecnologia da Informação" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card: Status de Coleta (visível apenas se coletado) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardColeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/holo_green_light"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✅ Status de Coleta"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/holo_green_dark"
                        android:layout_marginBottom="16dp" />

                    <!-- Status -->
                    <TextView
                        android:id="@+id/tvStatusColeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="✅ Coletado em 10/11/2024 14:30 por João Silva"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="8dp"
                        tools:text="✅ Coletado em 10/11/2024 14:30 por João Silva" />

                    <!-- Data -->
                    <TextView
                        android:id="@+id/tvDataColeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Data: 10/11/2024 14:30"
                        android:textSize="14sp"
                        android:textColor="@android:color/black"
                        android:layout_marginBottom="4dp"
                        tools:text="Data: 10/11/2024 14:30" />

                    <!-- Coletado Por -->
                    <TextView
                        android:id="@+id/tvColetadoPor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Por: João Silva"
                        android:textSize="14sp"
                        android:textColor="@android:color/black"
                        tools:text="Por: João Silva" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card: Divergências (visível apenas se houver) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardDivergencias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/holo_orange_light"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="⚠️ Divergências Encontradas"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/holo_orange_dark"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvDivergencias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Localização: Cadastrado em 'Sala 101', encontrado em 'Sala 102'"
                        android:textSize="14sp"
                        android:textColor="@android:color/black"
                        tools:text="Localização: Cadastrado em 'Sala 101', encontrado em 'Sala 102'" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <!-- ProgressBar (Loading) -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible" />

    <!-- Layout de Erro -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@android:drawable/stat_notify_error"
            android:alpha="0.3"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Erro ao carregar detalhes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAlignment="center" />

    </LinearLayout>

</FrameLayout>
