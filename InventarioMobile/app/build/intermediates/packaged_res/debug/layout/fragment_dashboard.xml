<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Indicador de Modo Offline (v2.7) -->
        <LinearLayout
            android:id="@+id/layoutOfflineIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/offline_indicator_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_offline"
                app:tint="@color/warning_dark" />

            <TextView
                android:id="@+id/tvOfflineStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Modo Offline Ativo"
                android:textColor="@color/warning_dark"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOfflineInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dados locais"
                android:textColor="@color/warning_dark"
                android:textSize="11sp"
                android:alpha="0.8" />

        </LinearLayout>

        <!-- Resumo do Inventário -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/gradient_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Resumo do Inventário"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Cards de Estatísticas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <!-- Botão Iniciar Coleta -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient_success"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/ic_check_circle"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tvKpiColetados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="4"
                        tools:text="8,156" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Coletados"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:alpha="0.9" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card Pendentes -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient_warning"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/ic_pending"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tvKpiPendentes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="4"
                        tools:text="2,089" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pendentes"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:alpha="0.9" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Cards de KPIs - Linha 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <!-- Card Divergências -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient_error"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/ic_warning_circle"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tvKpiDivergencias"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="4"
                        tools:text="127" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Divergências"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:alpha="0.9" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card Coletores -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient_info"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="8dp"
                        android:src="@drawable/ic_people"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tvKpiColetores"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:shadowColor="#40000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="4"
                        tools:text="12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Coletores"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:alpha="0.9" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Ações de Coleta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/gradient_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ações de Coleta"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
        
        <!-- Botão de Scan Rápido -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnQuickScan"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="@string/quick_scan"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_qr_code"
            app:iconGravity="textStart" />

        <!-- Botão de Coleta Manual -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManualCollection"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="@string/manual_collection_button"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_edit"
            app:iconGravity="textStart" />

        <!-- Botão de Coleta por Descrição (Sem Patrimônio) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDescriptionCollection"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="@string/description_collection_button"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_inventory"
            app:iconGravity="textStart" />

        <!-- Botão de Visualizar Coletas -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewCollections"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:text="@string/view_collections_button"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_collections"
            app:iconGravity="textStart" />

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Mensagem de Erro -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/error_background"
            android:padding="12dp"
            android:textColor="@color/error"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Erro ao carregar dados"
            tools:visibility="visible" />

    </LinearLayout>

</ScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

<!-- Floating Action Button para Busca por Voz -->
<com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/fabVoiceSearch"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:layout_margin="24dp"
    android:src="@drawable/ic_mic"
    android:contentDescription="Busca por voz"
    app:tint="@android:color/white"
    app:backgroundTint="@color/primary"
    app:elevation="6dp"
    app:pressedTranslationZ="12dp" />

<!-- Overlay de Escuta de Voz -->
<FrameLayout
    android:id="@+id/voiceListeningOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DD000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">
        
        <!-- Ícone de Microfone Animado -->
        <ImageView
            android:id="@+id/ivMicAnimation"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/primary"
            android:scaleType="centerInside" />
        
        <!-- Status da Escuta -->
        <TextView
            android:id="@+id/tvVoiceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Escutando..."
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold" />
        
        <!-- Texto Reconhecido (Parcial) -->
        <TextView
            android:id="@+id/tvVoiceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textAlignment="center"
            android:alpha="0.8"
            android:minHeight="48dp" />
        
        <!-- Sugestões de Comandos -->
        <TextView
            android:id="@+id/tvVoiceSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Experimente:\n• Buscar patrimônio 12345\n• Mostrar sala 203\n• Listar divergências"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textAlignment="center"
            android:alpha="0.6"
            android:lineSpacingExtra="4dp" />
        
        <!-- Botão Cancelar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelVoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Cancelar"
            android:textColor="@android:color/white"
            style="@style/Widget.Material3.Button.TextButton"
            app:strokeColor="@android:color/white"
            app:strokeWidth="1dp" />
        
    </LinearLayout>
    
</FrameLayout>

</FrameLayout>
