<?xml version="1.0" encoding="utf-8"?>
<!--
    Scanner de Coleta Rápida — Proposta 1 (Bottom Sheet)
    Câmera ocupa a tela inteira. Após scan, bottom sheet sobe com dados e botão de coleta.
    Sala e estado fixados em chips flutuantes sobre a câmera.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".presentation.scanner.ScannerActivity">

    <!-- ═══════════════════════════════════════════════════════════
         CAMADA 1 — Câmera (fundo, tela inteira)
         ═══════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/cameraContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ═══════════════════════════════════════════════════════════
         CAMADA 2 — Overlay escuro (aparece quando bottom sheet abre)
         ═══════════════════════════════════════════════════════════ -->
    <View
        android:id="@+id/scrimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <!-- ═══════════════════════════════════════════════════════════
         CAMADA 3 — Toolbar transparente sobre a câmera
         ═══════════════════════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_toolbar_gradient"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@android:color/white">

            <!-- Contador de coletas no centro da toolbar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@android:color/white"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/textColetasCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    tools:text="12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" coletados"
                    android:textSize="13sp"
                    android:textColor="#CCFFFFFF" />

            </LinearLayout>

            <!-- Botão histórico no canto direito -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="end"
                android:paddingEnd="4dp"
                android:id="@+id/cardContadorColetas"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_history"
                    app:tint="@android:color/white" />

            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══════════════════════════════════════════════════════════
         CAMADA 4 — Chips flutuantes (sala + estado) sobre a câmera
         ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutChipsFlutantes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="200dp">

        <!-- Chip Sala -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipSala"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Selecionar sala"
            android:textColor="@android:color/white"
            android:maxWidth="180dp"
            android:ellipsize="end"
            android:maxLines="1"
            app:chipBackgroundColor="#CC1565C0"
            app:chipIcon="@drawable/ic_location"
            app:chipIconTint="@android:color/white"
            app:chipStrokeWidth="1dp"
            app:chipStrokeColor="#661976D2"
            style="@style/Widget.MaterialComponents.Chip.Action"
            tools:text="Lab. Informática" />

        <!-- Chip Estado -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOM"
            android:textColor="@android:color/white"
            app:chipBackgroundColor="#CC2E7D32"
            app:chipIcon="@drawable/ic_check_circle"
            app:chipIconTint="@android:color/white"
            app:chipStrokeWidth="1dp"
            app:chipStrokeColor="#6643A047"
            style="@style/Widget.MaterialComponents.Chip.Action" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════
         CAMADA 5 — Status do scanner (centro da tela)
         ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="center"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="@android:color/white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aponte para o QR Code"
            android:textSize="13sp"
            android:textColor="@android:color/white"
            tools:text="Aponte para o QR Code" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════
         CAMADA 6 — Switch fixar estado (canto inferior esquerdo)
         ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutFixarEstado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_status_pill"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchFixarEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fixar estado"
            android:textSize="12sp"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/textEstadoFixoSelecionado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOM"
            android:textStyle="bold"
            android:paddingStart="6dp"
            android:visibility="gone"
            android:textSize="12sp"
            android:textColor="#80FF80" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════
         CAMADA 6.5 — Extended FAB "Coletar similar" (sempre visível sobre a câmera)
         Acesso permanente ao fluxo de coleta sem etiqueta.
         Posicionado em bottom|end para não obstruir a área central da câmera
         e ficar em coluna oposta ao layoutFixarEstado (bottom|start).
         ═══════════════════════════════════════════════════════════ -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabColetarSemEtiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:text="Coletar similar"
        android:textColor="@android:color/white"
        android:contentDescription="Coletar item similar sem etiqueta"
        app:icon="@drawable/ic_content_copy"
        app:iconTint="@android:color/white"
        app:backgroundTint="@color/teal_700"
        app:elevation="6dp" />

    <!-- ═══════════════════════════════════════════════════════════
         CAMADA 7 — Bottom Sheet com dados do patrimônio
         ═══════════════════════════════════════════════════════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet_rounded"
        android:elevation="16dp"
        android:visibility="gone"
        android:translationY="600dp">

        <!-- Drag handle -->
        <View
            android:id="@+id/dragHandle"
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_drag_handle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Número do patrimônio + badge de status -->
        <LinearLayout
            android:id="@+id/layoutNumeroStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@id/dragHandle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/textPatrimonioNumero"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="Nº 123456" />

            <!-- Badge status (Disponível / Já coletado) -->
            <TextView
                android:id="@+id/textPatrimonioStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_badge_success"
                tools:text="✓ Disponível" />

        </LinearLayout>

        <!-- Descrição -->
        <TextView
            android:id="@+id/textPatrimonioDescricao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="20dp"
            android:textSize="15sp"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/layoutNumeroStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Computador Desktop Dell Optiplex 7080" />

        <!-- Link "Ver detalhes completos" -->
        <TextView
            android:id="@+id/textVerDetalhes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="20dp"
            android:text="▼ Ver detalhes"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:paddingVertical="4dp"
            app:layout_constraintTop_toBottomOf="@id/textPatrimonioDescricao"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Painel de detalhes expandível (colapsado por padrão) -->
        <LinearLayout
            android:id="@+id/layoutDetalhesExpandidos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="6dp"
            android:layout_marginHorizontal="20dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:background="@drawable/bg_info_coleta"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/textVerDetalhes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Marca -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="Marca"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/textDetalheMarca"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Dell" />

            </LinearLayout>

            <!-- Modelo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="Modelo"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/textDetalheModelo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Optiplex 7080" />

            </LinearLayout>

            <!-- Estado cadastrado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="Estado"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/textDetalheEstado"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="Bom" />

            </LinearLayout>

            <!-- Valor -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:text="Valor"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/textDetalheValor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="R$ 3.500,00" />

            </LinearLayout>

        </LinearLayout>

        <!-- Sala + Responsável em linha -->
        <LinearLayout
            android:id="@+id/layoutMetaInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@id/layoutDetalhesExpandidos"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_location"
                app:tint="?attr/colorOnSurfaceVariant"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/textPatrimonioSala"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Lab. Informática" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_person"
                app:tint="?attr/colorOnSurfaceVariant"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/textPatrimonioResponsavel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="João Silva" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="20dp"
            android:background="?attr/colorOutlineVariant"
            app:layout_constraintTop_toBottomOf="@id/layoutMetaInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Informações de coleta anterior (visível quando já coletado) -->
        <LinearLayout
            android:id="@+id/layoutInfoColeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="20dp"
            android:padding="12dp"
            android:background="@drawable/bg_info_coleta"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/textColetadoPor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="6dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Coletado por: João Silva" />

            <TextView
                android:id="@+id/textDataColeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:drawableStart="@drawable/ic_calendar"
                android:drawablePadding="6dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Em: 27/11/2025 10:30" />

            <TextView
                android:id="@+id/textLocalizacaoEncontrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:drawableStart="@drawable/ic_location"
                android:drawablePadding="6dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Local encontrado: Sala 101" />

        </LinearLayout>

        <!-- Botão principal COLETAR (grande, verde) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonColetar"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="20dp"
            android:text="✓  COLETAR"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:visibility="gone"
            app:backgroundTint="@color/success"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/layoutInfoColeta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Linha de ações secundárias -->
        <LinearLayout
            android:id="@+id/layoutAcoesSecundarias"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/buttonColetar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Botão Escanear Outro -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRetry"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Escanear outro"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:icon="@drawable/ic_qr_code"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp" />

            <!-- Botão Coletar Similar — destaque visual para ação frequente -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonColetarSimilar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Coletar similar"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:icon="@drawable/ic_content_copy"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:backgroundTint="@color/teal_700"
                app:cornerRadius="12dp" />

            <!-- Botão Cancelar (quando não há scan) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCancel"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Fechar"
                android:textSize="13sp"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
