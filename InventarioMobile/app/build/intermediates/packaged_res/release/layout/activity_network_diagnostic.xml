<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_color">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_server"
            android:layout_marginEnd="8dp"
            android:contentDescription="Ícone de rede" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Diagnóstico de Rede - Android 14"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Fechar"
            android:textSize="12sp"
            android:backgroundTint="@color/material_grey_300"
            android:textColor="@color/text_primary" />

    </LinearLayout>

    <!-- Botões de Teste -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnTestConnectivity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Testar Conectividade"
            android:textSize="12sp"
            android:backgroundTint="@color/primary"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnTestServer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="Testar Servidor"
            android:textSize="12sp"
            android:backgroundTint="@color/primary"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnShowRecommendations"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Recomendações"
            android:textSize="12sp"
            android:backgroundTint="@color/secondary"
            android:textColor="@android:color/white" />

    </LinearLayout>

    <!-- Área de Resultados -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        android:layout_marginBottom="16dp">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <TextView
                android:id="@+id/textResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carregando diagnóstico inicial..."
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="2dp" />

        </ScrollView>

    </androidx.cardview.widget.CardView>

    <!-- Informações Adicionais -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Dica: Execute este diagnóstico quando houver problemas de conectividade no dispositivo físico"
        android:textSize="11sp"
        android:textStyle="italic"
        android:textColor="@color/text_secondary"
        android:background="@drawable/info_background"
        android:padding="8dp" />

</LinearLayout>