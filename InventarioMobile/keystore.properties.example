# Template para keystore.properties
# 
# ⚠️ INSTRUÇÕES:
# 1. Copie este arquivo para "keystore.properties" (sem o .example)
# 2. Preencha com suas credenciais reais da keystore
# 3. NUNCA commite o arquivo keystore.properties no Git!
#
# Este arquivo de exemplo PODE ser versionado no Git como referência.

# Senha da keystore
storePassword=SUA_SENHA_AQUI

# Senha da chave privada
keyPassword=SUA_SENHA_AQUI

# Alias da chave na keystore
keyAlias=SEU_ALIAS_AQUI

# Caminho para o arquivo da keystore (relativo a este arquivo)
# Exemplo: ../inventario-release.keystore
storeFile=../caminho/para/sua/keystore.jks

# ═══════════════════════════════════════════════════════════════
# SEGURANÇA - LEIA COM ATENÇÃO
# ═══════════════════════════════════════════════════════════════
#
# ✅ FAÇA:
# - Mantenha suas credenciais em um gerenciador de senhas seguro
# - Use senhas fortes e únicas para a keystore
# - Faça backup da keystore em local seguro
# - Rotacione as credenciais periodicamente
#
# ❌ NÃO FAÇA:
# - NUNCA commite keystore.properties no Git
# - NUNCA compartilhe suas credenciais por email/chat
# - NUNCA use senhas fracas ou padrão
# - NUNCA perca a keystore ou as senhas (impossível recuperar!)
#
# ═══════════════════════════════════════════════════════════════
