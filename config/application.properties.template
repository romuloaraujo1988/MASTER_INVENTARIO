# ============================================================
# SIHCP - Template de Configuração do Servidor
# Versão: 2.7.0
# ============================================================
# Substitua todos os placeholders {{...}} pelos valores reais
# antes de iniciar o servidor.
# ============================================================

# ------------------------------------------------------------
# Servidor
# ------------------------------------------------------------
server.port={{PORTA_API}}

# ------------------------------------------------------------
# Identificação do Campus
# ------------------------------------------------------------
campus.nome={{NOME_CAMPUS}}

# ------------------------------------------------------------
# Perfis Spring ativos
# ------------------------------------------------------------
spring.profiles.active=mobile,prod

# ------------------------------------------------------------
# Datasource (PostgreSQL)
# ------------------------------------------------------------
spring.datasource.url=jdbc:postgresql://{{HOST_PG}}:{{PORTA_PG}}/{{BANCO}}
spring.datasource.username={{USUARIO_PG}}
spring.datasource.password={{SENHA_PG}}
spring.datasource.driver-class-name=org.postgresql.Driver

# Pool de conexões HikariCP
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000

# ------------------------------------------------------------
# JPA / Hibernate
# ------------------------------------------------------------
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=false

# ------------------------------------------------------------
# Configuração de modo APP_DIR (lê config/ local)
# ------------------------------------------------------------
inventario.config.mode=APP_DIR

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
logging.level.root=INFO
logging.level.com.inventario=INFO
logging.file.name=logs/sistema-inventario-prod.log
logging.file.max-size=10MB
logging.file.max-history=30
