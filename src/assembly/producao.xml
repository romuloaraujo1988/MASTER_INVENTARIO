<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>producao</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>sistema-inventario-${project.version}</baseDirectory>
    
    <fileSets>
        <!-- JAR principal -->
        <fileSet>
            <directory>${project.build.directory}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>sistema-inventario-${project.version}.jar</include>
            </includes>
        </fileSet>
        
        <!-- Dependências -->
        <fileSet>
            <directory>${project.build.directory}/lib</directory>
            <outputDirectory>/lib</outputDirectory>
        </fileSet>
        
        <!-- Arquivos de configuração -->
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>/config</outputDirectory>
            <includes>
                <include>application.properties</include>
                <include>application-prod.properties</include>
            </includes>
        </fileSet>
        
        <!-- Scripts SQL -->
        <fileSet>
            <directory>${project.basedir}/sql</directory>
            <outputDirectory>/sql</outputDirectory>
            <includes>
                <include>**/*.sql</include>
            </includes>
        </fileSet>
        
        <!-- Documentação -->
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>/docs</outputDirectory>
            <includes>
                <include>README.md</include>
                <include>CHANGELOG.md</include>
                <include>INICIO_RAPIDO.md</include>
            </includes>
        </fileSet>
    </fileSets>
    
    <files>
        <!-- Script de inicialização Windows -->
        <file>
            <source>${project.basedir}/scripts/start-desktop.bat</source>
            <outputDirectory>/</outputDirectory>
            <destName>iniciar.bat</destName>
            <filtered>true</filtered>
        </file>
        
        <!-- Script de inicialização Linux/Mac -->
        <file>
            <source>${project.basedir}/scripts/start-desktop.sh</source>
            <outputDirectory>/</outputDirectory>
            <destName>iniciar.sh</destName>
            <filtered>true</filtered>
            <fileMode>0755</fileMode>
        </file>
        
        <!-- README de instalação -->
        <file>
            <source>${project.basedir}/scripts/LEIA-ME-INSTALACAO.txt</source>
            <outputDirectory>/</outputDirectory>
            <destName>LEIA-ME.txt</destName>
            <filtered>true</filtered>
        </file>
    </files>
</assembly>
