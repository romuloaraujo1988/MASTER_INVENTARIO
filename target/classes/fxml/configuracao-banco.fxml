<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.inventario.ui.ConfiguracaoBancoController">
   <top>
      <VBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Configuração do Banco de Dados" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label text="Configure a conexão com o PostgreSQL" textAlignment="CENTER" />
            <Separator />
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" BorderPane.alignment="CENTER">
         <content>
            <VBox spacing="15.0">
               <children>
                  <GridPane hgap="10.0" vgap="15.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="NEVER" minWidth="120.0" prefWidth="120.0" />
                      <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="300.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <Label text="Host:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtHost" promptText="localhost" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        
                        <Label text="Porta:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtPort" promptText="5432" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        
                        <Label text="Banco:" GridPane.columnIndex="0" GridPane.rowIndex="2">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtDatabase" promptText="sispatrimonio" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        
                        <Label text="Usuário:" GridPane.columnIndex="0" GridPane.rowIndex="3">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtUsername" promptText="postgres" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        
                        <Label text="Senha:" GridPane.columnIndex="0" GridPane.rowIndex="4">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <PasswordField fx:id="txtPassword" promptText="Digite a senha" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        
                        <Label text="Schema:" GridPane.columnIndex="0" GridPane.rowIndex="5">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtSchema" promptText="public" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                        
                        <Label text="SSL:" GridPane.columnIndex="0" GridPane.rowIndex="6">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <CheckBox fx:id="chkSsl" mnemonicParsing="false" text="Usar conexão SSL" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                     </children>
                  </GridPane>
                  
                  <Separator />
                  
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Label fx:id="lblStatus" text="Preencha os dados de conexão" />
                        <ProgressIndicator fx:id="progressIndicator" prefHeight="20.0" prefWidth="20.0" visible="false" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="30.0" right="30.0" top="10.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   <bottom>
      <HBox alignment="CENTER" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnTestarConexao" mnemonicParsing="false" prefWidth="120.0" text="Testar Conexão">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="btnSalvar" mnemonicParsing="false" prefWidth="80.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Salvar">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
            <Button fx:id="btnCancelar" mnemonicParsing="false" prefWidth="80.0" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Cancelar">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>